{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omoi-iro.invalid/schemas/show.schema.json",
  "title": "OMOI-IRO Show 0.1.2",
  "description": "Show file schema. Cross-reference, ID uniqueness, drop-frame and interval checks require semantic validation. 0.1.0 and 0.1.1 files are read by migration (version only; 0.1.2 adds builtin.strobe, builtin.noise, builtin.ripple, builtin.rain, builtin.wave, builtin.orb and the optional chase reverse).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "seed",
    "sync",
    "render",
    "preview",
    "targets",
    "presets",
    "layers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "schema_version": {
      "const": "0.1.2"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "sync": {
      "$ref": "#/$defs/sync"
    },
    "render": {
      "$ref": "#/$defs/render"
    },
    "preview": {
      "$ref": "#/$defs/preview"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preset"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "minItems": 0,
      "maxItems": 8
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timeUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timecode",
        "beat_source",
        "stop_behavior",
        "loss"
      ],
      "properties": {
        "timecode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "frame_rate",
            "origin",
            "input_offset_us"
          ],
          "properties": {
            "source": {
              "description": "live_bridge: the song time from the Live Remote Script is the common clock (frame_rate / origin label the MTC output). mtc: an external MTC input.",
              "enum": [
                "live_bridge",
                "mtc"
              ]
            },
            "frame_rate": {
              "enum": [
                "24",
                "25",
                "29.97df",
                "30"
              ]
            },
            "origin": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]:[0-2][0-9]$"
            },
            "input_offset_us": {
              "type": "integer",
              "minimum": -10000000,
              "maximum": 10000000
            }
          }
        },
        "beat_source": {
          "description": "Exactly one beat input. Ableton Link Start Stop Sync is never used.",
          "enum": [
            "ableton_link",
            "midi_clock"
          ]
        },
        "stop_behavior": {
          "enum": [
            "hold",
            "blackout"
          ]
        },
        "loss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "holdover_ms",
            "blackout_after_ms",
            "recovery_fade_ms"
          ],
          "properties": {
            "holdover_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "blackout_after_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "recovery_fade_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            }
          }
        },
        "mtc_output": {
          "description": "Optional MTC output generated by the app (frame rate and origin from timecode). Port selection belongs to the terminal settings, not the show.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps",
        "master_brightness"
      ],
      "properties": {
        "fps": {
          "enum": [
            30,
            60
          ]
        },
        "master_brightness": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpm"
      ],
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 20,
          "maximum": 300
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "profile"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "profile": {
          "const": "novation.launchpad_x.grid64.v1"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "builtin.solid",
            "builtin.chase",
            "builtin.pulse",
            "builtin.strobe",
            "builtin.noise",
            "builtin.ripple",
            "builtin.rain",
            "builtin.wave",
            "builtin.orb"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.solid"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.solid"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.chase"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.chase"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "period_us",
                  "width",
                  "axis"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "period_us": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 3600000000
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "axis": {
                    "enum": [
                      "x",
                      "y"
                    ]
                  },
                  "reverse": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.pulse"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.pulse"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "beats_per_cycle",
                  "depth",
                  "waveform"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "beats_per_cycle": {
                    "enum": [
                      0.25,
                      0.5,
                      1
                    ]
                  },
                  "depth": {
                    "$ref": "#/$defs/unit"
                  },
                  "waveform": {
                    "enum": [
                      "sine",
                      "triangle"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.strobe"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.strobe"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "mode",
                  "rate_hz",
                  "beats_per_cycle",
                  "duty",
                  "phase_offset"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "mode": {
                    "enum": [
                      "hz",
                      "beat"
                    ]
                  },
                  "rate_hz": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 30
                  },
                  "beats_per_cycle": {
                    "enum": [
                      0.25,
                      0.5,
                      1,
                      2
                    ]
                  },
                  "duty": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 0.95
                  },
                  "phase_offset": {
                    "$ref": "#/$defs/unit"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.noise"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.noise"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "base_color",
                  "highlight_color",
                  "density",
                  "rate_hz",
                  "seed",
                  "smooth",
                  "depth"
                ],
                "properties": {
                  "base_color": {
                    "$ref": "#/$defs/color"
                  },
                  "highlight_color": {
                    "$ref": "#/$defs/color"
                  },
                  "density": {
                    "$ref": "#/$defs/unit"
                  },
                  "rate_hz": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 30
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "smooth": {
                    "type": "boolean"
                  },
                  "depth": {
                    "$ref": "#/$defs/unit"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.ripple"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.ripple"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "speed",
                  "ring_width",
                  "lifetime_ms",
                  "fade",
                  "max_concurrent",
                  "trigger"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 16
                  },
                  "ring_width": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 4
                  },
                  "lifetime_ms": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 4000
                  },
                  "fade": {
                    "enum": [
                      "linear",
                      "exp"
                    ]
                  },
                  "max_concurrent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "trigger": {
                    "enum": [
                      "any_pad"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.rain"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.rain"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "direction",
                  "speed",
                  "density",
                  "tail",
                  "seed",
                  "flicker"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "head_color": {
                    "$ref": "#/$defs/color"
                  },
                  "direction": {
                    "enum": [
                      "down",
                      "up",
                      "left",
                      "right"
                    ]
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 16
                  },
                  "density": {
                    "$ref": "#/$defs/unit"
                  },
                  "tail": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "flicker": {
                    "$ref": "#/$defs/unit"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.wave"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.wave"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "axis",
                  "wavelength",
                  "amplitude",
                  "center",
                  "speed",
                  "thickness",
                  "beat_amplitude"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "axis": {
                    "enum": [
                      "x",
                      "y"
                    ]
                  },
                  "wavelength": {
                    "type": "number",
                    "minimum": 2,
                    "maximum": 16
                  },
                  "amplitude": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 3.5
                  },
                  "center": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "speed": {
                    "type": "number",
                    "minimum": -4,
                    "maximum": 4
                  },
                  "thickness": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 3
                  },
                  "beat_amplitude": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "builtin.orb"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "params"
            ],
            "properties": {
              "type": {
                "const": "builtin.orb"
              },
              "version": {
                "const": 1
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "center_x",
                  "center_y",
                  "radius",
                  "edge",
                  "light_angle",
                  "shading",
                  "dither",
                  "dither_rate_hz",
                  "seed",
                  "motion",
                  "speed",
                  "orbit_radius",
                  "bounce_angle"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "center_x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "center_y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "radius": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 6
                  },
                  "edge": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "light_angle": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 360
                  },
                  "shading": {
                    "$ref": "#/$defs/unit"
                  },
                  "dither": {
                    "$ref": "#/$defs/unit"
                  },
                  "dither_rate_hz": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 15
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "motion": {
                    "enum": [
                      "none",
                      "orbit",
                      "bounce"
                    ]
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "orbit_radius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "bounce_angle": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 360
                  }
                }
              }
            }
          }
        }
      ]
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "preset_id",
        "start_us",
        "duration_us",
        "fade_in_us",
        "fade_out_us"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "preset_id": {
          "$ref": "#/$defs/id"
        },
        "start_us": {
          "$ref": "#/$defs/timeUs"
        },
        "duration_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fade_in_us": {
          "$ref": "#/$defs/timeUs"
        },
        "fade_out_us": {
          "$ref": "#/$defs/timeUs"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "timeline",
            "continuous"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timeline"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "clips"
            ],
            "properties": {
              "kind": {
                "const": "timeline"
              },
              "clips": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/clip"
                },
                "minItems": 0,
                "maxItems": 4096
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "continuous"
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "preset_id"
            ],
            "properties": {
              "kind": {
                "const": "continuous"
              },
              "preset_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "target_id",
        "enabled",
        "opacity",
        "blend",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "opacity": {
          "$ref": "#/$defs/unit"
        },
        "blend": {
          "enum": [
            "over",
            "add",
            "max"
          ]
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    }
  }
}
