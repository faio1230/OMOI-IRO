{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMOI-IRO",
  "version": "0.1.0",
  "identifier": "jp.faio.omoiiro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OMOI-IRO",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "OMOI-IRO",
    "shortDescription": "OMOI-IRO: Ableton Live に追従する LED 演出"
  }
}
