{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the OMOI-IRO commands, plus the dialog plugin's open and save pickers only (they return a path; Rust checks it). No file system, shell, HTTP or other plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-list-ports",
    "allow-runtime-start",
    "allow-runtime-stop",
    "allow-runtime-status",
    "allow-set-blackout",
    "allow-set-brightness",
    "allow-reset-control-fault",
    "allow-reconnect-ports",
    "allow-preview-subscribe",
    "allow-preview-ack",
    "allow-preview-open",
    "allow-preview-mode",
    "allow-preview-play",
    "allow-preview-seek",
    "allow-preview-set-bpm",
    "allow-preview-pad",
    "allow-settings-get",
    "allow-settings-check",
    "allow-settings-save",
    "allow-settings-listen",
    "allow-editor-open",
    "allow-editor-view",
    "allow-material-preview",
    "allow-editor-apply",
    "allow-editor-undo",
    "allow-editor-redo",
    "allow-preset-import",
    "allow-frames-import",
    "allow-recording-stop",
    "allow-reset-input",
    "allow-recording-start",
    "allow-preset-export",
    "allow-editor-save",
    "allow-editor-save-as",
    "allow-editor-new",
    "allow-close-decision",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
